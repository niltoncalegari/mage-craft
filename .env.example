# Client (Vite) — only needed if the API isn't reachable at the same origin
# (dev proxy in vite.config.ts and Nginx in prod cover the normal case).
# VITE_API_URL=http://localhost:4000

# docker-compose — used by the `mongo`, `api`, `gameserver` and `client` services.
MONGO_URI=mongodb://mongo:27017/mage-craft
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
MATCH_INGEST_API_KEY=change-me-in-production
CORS_ORIGIN=http://localhost:8080
API_PORT=4000
GAMESERVER_PORT=8080
CLIENT_PORT=8080
