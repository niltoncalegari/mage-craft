# Copy to .env before `docker compose up`. See DEPLOY.md.
#
# JWT_SECRET and MATCH_INGEST_API_KEY have no defaults in docker-compose.yml —
# the stack refuses to start until you set them. Generate each with:
#   openssl rand -hex 32

# ---- Required ----
JWT_SECRET=change-me-in-production
MATCH_INGEST_API_KEY=change-me-in-production

# ---- Public entrypoint ----
# The host port Nginx is published on. Everything (game, /api, /ws) is served
# from it, so this is the only port that has to be open on the VPS firewall.
CLIENT_PORT=8080
# What players type in the browser, scheme included. Used as the API's CORS
# origin. With no domain yet this is just the VPS address:
#   PUBLIC_ORIGIN=http://203.0.113.10:8080
PUBLIC_ORIGIN=http://localhost:8080

# ---- Optional ----
MONGO_URI=mongodb://mongo:27017/mage-craft
JWT_EXPIRES_IN=7d

# ---- Local dev only (not read by compose) ----
# The client reaches /api and /ws on its own origin by default — Vite proxies
# both in dev, Nginx in production. Only set these for a split-host setup.
# VITE_API_URL=http://localhost:4000
# VITE_WS_URL=ws://localhost:8080/ws
